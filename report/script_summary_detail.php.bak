										$total_s_sukses = $total_s_sukses + $row_data['sample_sukses'];
										$total_s_gagal = $total_s_gagal + $row_data['sample_gagal'];
									}
								?>
                                <tr height="30" style="font-weight:bold">
                                <td align="center" colspan="3">T O T A L</td>
