		$.post('script_summary_detail.php?act=view_bodymailterbaca&read_email_id='+read_email_id,"",function(respon){
			$.fancybox(respon);
		});
	}
	function view_template(val){
		var antrian_id = val;
		$.post('script_summary_detail.php?act=view_template&antrian_id='+antrian_id,"",function(respon){
			$.fancybox(respon);
		});
	}
</script>