	function show_list_pdf(){
		$m_loading_id = $_REQUEST['m_loading_id'];
		$blth  = $_REQUEST['blth'];
		
		$sql = "SELECT loading_file FROM m_loading ";
		
		if ($blth == "")
		{ 
		$where = " WHERE m_loading_id = $m_loading_id";
		}
		else
		{
		$where .= " WHERE blth = '$blth' ";
		}
		
		$sql =  $sql . $where;
		$qry = pg_query($sql) or die('ERROR query: '.$sql);
		$row = pg_fetch_assoc($qry);
		$nama_file = $row['loading_file'];
		?>
