                                	<td align="center"><b>Email di Antrian</b></td>
                                	<td align="center"><b>Email Sukses</b></td>
                                	<td align="center"><b>Email Gagal</b></td>
									<td align="center"><b>Email Terbaca</b></td>
                                	<td align="center"><b>Sample Sukses</b></td>
                                	<td align="center"><b>Sample Gagal</b></td>
                                </tr>
                                <?php
									if (!empty($cycle)){
										$w_cycle ="and a.loading_file = '".$cycle."'";
									}else{
										$w_cycle ="";
									}
									if (!empty($sent_from)){
										$js_pkirim ="AND (date_email_send BETWEEN '".$sent_from."' AND '".$sent_to."')";
										$p_kirim = "and a.m_loading_id in (select loading_id from tr_email where date_email_send BETWEEN '".$sent_from."' AND '".$sent_to."') ";
									}else{
										$js_pkirim = "";
										$p_kirim = "";
									}
									$i = 0;
									$sql_data = "
										SELECT
											a.m_loading_id,
											to_char(a.create_date,'yyyy-mm-dd HH24:MI') as create_date,
											a.loading_file,
											a.total_customer as jml_pdf,
											a.total_halaman as jml_lembar,
											c.jml_email,
											d.jml_antrian,
											e.email_sukses,
											et.email_terbaca,
											f.email_gagal,
											g.sample_sukses,
											h.sample_gagal
										FROM m_loading a
											LEFT JOIN detail b
												ON a.m_loading_id = b.m_loading_id
											LEFT JOIN (
												SELECT count(*) as jml_email, m_loading_id
												FROM vw_email
												GROUP BY m_loading_id
											) c
												ON a.m_loading_id = c.m_loading_id
											LEFT JOIN (
												SELECT count(*) as jml_antrian, loading_id
												FROM antrian_email
												GROUP BY loading_id
											) d
												ON a.m_loading_id = d.loading_id
											LEFT JOIN (SELECT
													   count(*)          as email_sukses,   loading_id
													 FROM tr_email a
													   LEFT JOIN vw_email b
														 ON a.loading_id = b.m_loading_id
														   and a.nomor_rekening = b.nomor_rekening   and a.email = b.email
													 WHERE date_email_callback is null ".$js_pkirim."
													 and b.nomor_rekening is not null
													 AND status_sample IS NOT TRUE
													 GROUP BY loading_id
													) e
												ON a.m_loading_id = e.loading_id
											LEFT JOIN (
												SELECT count(*) as email_gagal, loading_id
												FROM tr_email a
													LEFT JOIN vw_email b
														ON a.loading_id = b.m_loading_id and a.nomor_rekening = b.nomor_rekening and a.email = b.email
												WHERE date_email_callback is not null ".$js_pkirim."
												and b.nomor_rekening is not null
												AND status_sample IS NOT TRUE
												GROUP BY loading_id
											) f
												ON a.m_loading_id = f.loading_id
											LEFT JOIN (
												SELECT count(*) as email_terbaca, loading_id
												FROM (select * from tr_email where tgl_read is not null) a
													LEFT JOIN vw_email b
														ON a.loading_id = b.m_loading_id and a.nomor_rekening = b.nomor_rekening and a.email = b.email
												WHERE date_email_callback is null ".$js_pkirim."
												and b.nomor_rekening is not null
												AND status_sample IS NOT TRUE
												GROUP BY loading_id
											) et
												ON a.m_loading_id = et.loading_id
											LEFT JOIN (
												SELECT count(*) as sample_sukses, loading_id
												FROM tr_email a
													LEFT JOIN vw_email b
														ON a.loading_id = b.m_loading_id and a.nomor_rekening = b.nomor_rekening and a.email = b.email
												WHERE date_email_callback is null ".$js_pkirim."
												and a.status_sample is true 
												GROUP BY loading_id
											) g
												ON a.m_loading_id = g.loading_id
											LEFT JOIN (
												SELECT count(*) as sample_gagal, loading_id
												FROM tr_email a
													LEFT JOIN vw_email b
														ON a.loading_id = b.m_loading_id and a.nomor_rekening = b.nomor_rekening and a.email = b.email
												WHERE date_email_callback is not null ".$js_pkirim."
												and a.status_sample is true 
												GROUP BY loading_id
											) h
												ON a.m_loading_id = h.loading_id
										WHERE a.blth = '$blth' and a.flagtrans = '$flagtrans' 
										".$p_kirim."
										".$w_cycle."
										GROUP BY a.m_loading_id, to_char(a.create_date,'yyyy-mm-dd HH24:MI'), a.loading_file, a.total_customer, a.total_halaman,
											c.jml_email, d.jml_antrian, e.email_sukses, f.email_gagal, et.email_terbaca, g.sample_sukses, h.sample_gagal
										ORDER BY a.m_loading_id
									";
									$qry_data = pg_query($sql_data) or die('ERROR select summary detail: '.$sql_data);	//echo $sql_data;
									while($row_data = pg_fetch_array($qry_data)){
										$i++;
										$m_loading_id = $row_data['m_loading_id'];
									?>
									<tr height="30">
										<td align="center"><?php echo $i?></td>
										<td align="center"><?php echo $row_data['create_date']?></td>
										<td align="center"><?php echo $row_data['loading_file']?></td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_list_pdf&m_loading_id=<?php echo $m_loading_id?>')"><?php echo number_format($row_data['jml_pdf'],0,'',',')?></a>&nbsp;&nbsp;</td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_list_pdf&m_loading_id=<?php echo $m_loading_id?>')"><?php echo number_format($row_data['jml_lembar'],0,'',',')?></a>&nbsp;&nbsp;</td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_list_email&m_loading_id=<?php echo $m_loading_id?>')"><?php echo number_format($row_data['jml_email'],0,'',',')?></a>&nbsp;&nbsp;</td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_list_antrian&m_loading_id=<?php echo $m_loading_id?>')"><?php echo number_format($row_data['jml_antrian'],0,'',',')?></a>&nbsp;&nbsp;</td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_email_sukses&m_loading_id=<?php echo $m_loading_id?><?php if (!empty($_GET['periode_kirim'])){echo '&periode_kirim='.$_GET['periode_kirim'];}?>')"><?php echo number_format($row_data['email_sukses'],0,'',',')?></a>&nbsp;&nbsp;</td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_email_gagal&m_loading_id=<?php echo $m_loading_id?><?php if (!empty($_GET['periode_kirim'])){echo '&periode_kirim='.$_GET['periode_kirim'];}?>')"><?php echo number_format($row_data['email_gagal'],0,'',',')?></a>&nbsp;&nbsp;</td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_email_terbaca&m_loading_id=<?php echo $m_loading_id?><?php if (!empty($_GET['periode_kirim'])){echo '&periode_kirim='.$_GET['periode_kirim'];}?>')"><?php echo number_format($row_data['email_terbaca'],0,'',',')?></a>&nbsp;&nbsp;</td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_email_sample_sukses&m_loading_id=<?php echo $m_loading_id?><?php if (!empty($_GET['periode_kirim'])){echo '&periode_kirim='.$_GET['periode_kirim'];}?>')"><?php echo number_format($row_data['sample_sukses'],0,'',',')?></a>&nbsp;&nbsp;</td>
										<td align="right"><a onClick="window.open('script_summary_detail.php?act=show_email_sample_gagal&m_loading_id=<?php echo $m_loading_id?><?php if (!empty($_GET['periode_kirim'])){echo '&periode_kirim='.$_GET['periode_kirim'];}?>')"><?php echo number_format($row_data['sample_gagal'],0,'',',')?></a>&nbsp;&nbsp;</td>
									</tr>
									<?php
										$total_pdf = $total_pdf + $row_data['jml_pdf'];
										$total_lembar = $total_lembar + $row_data['jml_lembar'];
										$total_email = $total_email + $row_data['jml_email'];
										$total_antrian = $total_antrian + $row_data['jml_antrian'];
										$total_e_sukses = $total_e_sukses + $row_data['email_sukses'];
										$total_e_gagal = $total_e_gagal + $row_data['email_gagal'];
